SELECT
    bucket * 429496724 AS interval_start,
    bucket * 429496724 + 429496724 - 1 AS interval_end,
    COUNT(*)
FROM (
    SELECT
        ABS(CAST(HASHROW(CAST(id_client AS VARCHAR(100))) AS INT)) / 429496724 AS bucket
    FROM
        schema.client
    WHERE
        DATE '2023-08-01' <= dt_to 
        AND DATE '2023-08-31' >= dt_from
) AS subquery
GROUP BY
    bucket
ORDER BY
    bucket



