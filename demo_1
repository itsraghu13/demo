bounds_df = spark.read.jdbc(url=jdbc_url, table=query, properties=properties)
min_val, max_val = bounds_df.collect()[0]

# Calculate stride for partitions
stride = math.ceil((max_val - min_val) / num_partitions)

# Generate WHERE clauses for partitions
partitions = []
