from pyspark.sql import SparkSession
import math
from datetime import datetime, timedelta

# Initialize Spark session
spark = SparkSession.builder.appName("Teradata Predicate Generator").getOrCreate()

# JDBC URL and connection properties
jdbc_url = "jdbc:teradata://<your-host>/DATABASE=<db>"
jdbc_props = {
    "user": "<user>",
    "password": "<password>",
    "driver": "com.teradata.jdbc.TeraDriver"
}

# Table and database names
database_name = "your_db"
table_name = "your_table"
partition_count = 10  # Adjust for number of partitions

# Step 1: Fetch composite primary key columns from dbc.IndicesV
pk_df = spark.read.jdbc(jdbc_url, "dbc.IndicesV", properties=jdbc_props) \
    .filter((col("DatabaseName") == database_name) &
            (col("TableName") == table_name) &
            (col("IndexType") == "K")) \
    .select("ColumnName", "ColumnPosition") \
    .orderBy("ColumnPosition")

pk_cols = [row["ColumnName"] for row in pk_df.collect()]

# Step 2: Get min/max values for each PK column
stats = {}
for pk in pk_cols:
    bounds_query = f"(SELECT MIN({pk}) AS min_val, MAX({pk}) AS max_val FROM {database_name}.{table_name}) AS bounds"
    bounds_df = spark.read.jdbc(jdbc_url, bounds_query, properties=jdbc_props)
    row = bounds_df.first()
    if row and row["min_val"] is not None and row["max_val"] is not None:
        stats[pk] = (row["min_val"], row["max_val"])

# Step 3: Create predicates with multi-column composite key ranges
predicates = []

# We generate combinations of ranges for each PK column
ranges = {}

# Generate ranges for each PK column
# Adjusted logic for handling upper bounds properly
for pk in pk_cols:
    pk_min, pk_max = stats[pk]
    step = math.ceil((pk_max - pk_min + 1) / partition_count)
    
    pk_ranges = []
    for i in range(partition_count):
        lower = pk_min + i * step
        # Ensure the upper bound does not exceed the max value of pk_max
        upper = min(pk_min + (i + 1) * step - 1, pk_max)
        pk_ranges.append((lower, upper))

    ranges[pk] = pk_ranges


# Now we need to combine predicates for each partition.
for i in range(partition_count):
    predicate_parts = []
    for pk in pk_cols:
        lower, upper = ranges[pk][i]
        predicate_parts.append(f"{pk} BETWEEN {lower} AND {upper}")
    predicates.append(" AND ".join(predicate_parts))

# Step 4: Print predicates for validation
for p in predicates:
    print(f"Generated Predicate: {p}")

# Step 5: Use predicates in the JDBC read
df = spark.read.jdbc(
    url=jdbc_url,
    table=table_name,
    predicates=predicates,
    properties=jdbc_props
)
df.show()
