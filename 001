def exec_query(query):
    spark = getSparkSession()
    df = spark.read \
        .format("jdbc") \
        .option("url", jdbc_url) \
        .option("dbtable", f"({query}) as subq") \
        .option("user", properties['user']) \
        .option("password", properties['password']) \
        .option("driver", "com.ibm.db2.jcc.DB2Driver") \
        .option("inferSchema", True) \
        .load()
    return df

def exec_query1(query, partitionName, minValue, maxValue):
    programArgument = readProgramArguments()
    spark = getSparkSession()
    df = spark.read \
        .format("jdbc") \
        .option("url", jdbc_url) \
        .option("dbtable", f"({query}) as subq") \
        .option("user", properties['user']) \
        .option("password", properties['password']) \
        .option("driver", "com.ibm.db2.jcc.DB2Driver") \
        .option("inferSchema", True) \
        .option("partitionColumn", partitionName) \
        .option("lowerBound", minValue) \
        .option("upperBound", maxValue) \
        .option("numPartitions", f"{programArgument['NUM_PARTITIONS']}") \
        .load()
    return df

def getPartitionColumn(tableName: str):
    spark = getSparkSession()
    spark.sparkContext.setLogLevel('ERROR')

    # Get table schema and filter integer/long columns
    get_columns = exec_query(f"SELECT * FROM {tableName} LIMIT 1")
    filtered_columns = [f.name for f in get_columns.schema.fields if isinstance(f.dataType, (IntegerType, LongType))]

    if not filtered_columns:
        log.warning("No integer/long columns found for partitioning")
        return None

    # Construct and execute query efficiently
    query = f"SELECT {', '.join(f'COUNT(DISTINCT {col}) AS {col}' for col in filtered_columns)} FROM {tableName}"
    log.info(f"Executing query: {query}")

    df = exec_query(query)
    row = df.collect()[0]  # Collect only one row

    log.info(row.asDict())

    # Determine the column with the highest distinct count
    partition_col = max(row.asDict(), key=row.asDict().get)
    log.info(f"Partition column is {partition_col}")

    return partition_col




