
SELECT 
    columnname,
    COUNT(*) AS total_rows,
    COUNT(DISTINCT columnname) AS distinct_values,
    MAX(columnname) AS max_val,
    MIN(columnname) AS min_val,
    CAST(MAX(c) AS FLOAT) / COUNT(*) * 100 AS skew_percent
FROM (
    SELECT columnname, COUNT(*) AS c
    FROM YourDatabase.YourTable
    GROUP BY columnname
) a;






SELECT 
    c.databasename,
    c.tablename,
    c.columnname,
    c.partitioningcolumn AS is_partition_column,
    i.indexnumber,
    i.indexname,
    i.uniqueflag AS is_unique_index,
    i.indextype,
    i.columnposition,
    i.columnname AS index_column
FROM dbc.columnsV c
LEFT JOIN dbc.indicesV i
    ON c.databasename = i.databasename
    AND c.tablename = i.tablename
    AND c.columnname = i.columnname
WHERE c.databasename = 'YourDatabase'
  AND c.tablename = 'YourTable'
ORDER BY 
    is_partition_column DESC, 
    i.indexnumber, 
    i.columnposition;
